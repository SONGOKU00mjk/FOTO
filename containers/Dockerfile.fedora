FROM fedora:latest
RUN dnf install -y \
      gcc gcc-c++ make pkgconf-pkg-config libxkbcommon-devel wayland-devel \
      git curl sudo rust cargo \
 && useradd -m -s /bin/sh builder \
 && echo 'builder ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/builder
USER builder
WORKDIR /home/builder
CMD ["sh", "-c", "sh /repo/install.sh --user --no-rustup && test -x $HOME/.local/bin/foto && $HOME/.local/bin/foto --help >/dev/null && echo 'SMOKE OK: fedora'"]
